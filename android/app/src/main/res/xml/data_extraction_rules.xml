<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12 (API 31) and higher, see
     https://developer.android.com/identity/data/autobackup. The reader's progress lives in files/record/
     (Application Support, written by FileRecordRepository) and follows the reader to a new device through
     cloud backup and device-to-device transfer. With an include rule only the included files are copied,
     so the content cache and everything else stay on this device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="record/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="record/"/>
    </device-transfer>
</data-extraction-rules>
