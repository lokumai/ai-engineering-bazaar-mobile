<?xml version="1.0" encoding="utf-8"?>
<!-- The default app icon: the pocket model's robot in its fez on the dark page colour (lib/shared/app_icon/, drawn by
     tool/render_app_icons.dart); the monochrome layer is the themed icon Android 13 and later tints after the
     wallpaper and the dark theme. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
