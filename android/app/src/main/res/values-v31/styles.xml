<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own launch screen, with no icon (the opening brings the robot): on the dark page colour,
         the look the app opens in until the reader chooses, whatever the phone's theme (owner, 2026-11-15). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/bazaar_page</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/bazaar_page</item>
    </style>
    <!-- The launch screen of the light look, on its cream page colour: Android 13 and later show it from the next
         launch once LaunchGround.kt sets it. -->
    <style name="LaunchTheme.Light">
        <item name="android:windowBackground">@color/ic_launcher_cream_background</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_cream_background</item>
    </style>
</resources>
