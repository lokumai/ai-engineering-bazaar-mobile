iklik."}]},{"type":"diagram","number":"4.4","title":"Örnek Tool'lar","svg":{"light":"api/v1/diagrams/90f2b1ead7befe6bfd292ed93ca2f3ab.svg","dark":"api/v1/diagrams/a353ea39fb3c02f0ddb11ee7045ac1a5.svg"}},{"type":"heading","depth":2,"id":"temel-terimler","inlines":[{"type":"text","text":"Temel Terimler"}]},{"type":"list","ordered":false,"items":[{"blocks":[{"type":"paragraph","inlines":[{"type":"strong","inlines":[{"type":"text","text":"Tool"}]},{"type":"text","text":": senin yazdığın, modelin istediğinde host'un çalıştırdığı bir fonksiyon."}]}]},{"blocks":[{"type":"paragraph","inlines":[{"type":"strong","inlines":[{"type":"text","text":"Context"}]},{"type":"text","text":": modelin okuduğu ve her tool call'ın iki mesaj daha eklediği mesaj yığını."}]}]},{"blocks":[{"type":"paragraph","inlines":[{"type":"strong","inlines":[{"type":"text","text":"Tool call"}]},{"type":"text","text":": modelin host'tan bir tool'u çalıştırmasını istediği mesaj; model yalnızca ister, kendisi çalıştırmaz."}]}]},{"blocks":[{"type":"paragraph","inlines":[{"type":"strong","inlines":[{"type":"text","text":"Host"}]},{"type":"text","text":": fonksiyonlarını çalıştıran makine, yani dizüstü bilgisayarın ya da sunucun."}]}]},{"blocks":[{"type":"paragraph","inlines":[{"type":"strong","inlines":[{"type":"text","text":"Tool result"}]},{"type":"text","text":": host fonksiyonu çalıştırdıktan sonra, dönüş değeriyle birlikte yazdığı mesaj."}]}]},{"blocks":[{"type":"paragraph","inlines":[{"type":"strong","inlines":[{"type":"text","text":"Tool schema"}]},{"type":"text","text":": bir tool'un JSON ile yazılmış tanımı: adı, ne yaptığı ve argümanları."}]}]},{"blocks":[{"type":"paragraph","inlines":[{"type":"strong","inlines":[{"type":"text","text":"@tool decorator"}]},{"type":"text","text":": framework'ün şemayı fonksiyonun adından, docstring'inden ve type hint'lerinden üretmesini sağlayan dekoratör."}]}]},{"blocks":[{"type":"paragraph","inlines":[{"type":"strong","inlines":[{"type":"text","text":"Tool call ID"}]